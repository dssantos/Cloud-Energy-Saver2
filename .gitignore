*.txt
!requirements.txt
*.csv
models/
models_mv/
.ces2/
__pycache__/
.vscode
.env
.venv/
events_*.json

# Analysis outputs (regenerable from events + cluster_workload CSVs)
analysis_*.json
TCC_METRICS_*.md

